# Copy to .env. The defaults below work with `docker compose up -d db minio`.

APP_URL=http://localhost:3000
DATABASE_URL=postgresql://vividh:vividh@localhost:5432/vividh

# openssl rand -base64 32
SESSION_SECRET=change-me-to-32-random-bytes-in-production

# Google OAuth client (see docs/RUNBOOK.md). Not needed locally when DEV_LOGIN=1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ALLOWED_DOMAIN=ltsu.ac.in
USET_SUFFIX=.uset@ltsu.ac.in
# These accounts become owners on first sign-in (President, Faculty Coordinator)
OWNER_EMAILS=president.uset@ltsu.ac.in,coordinator@ltsu.ac.in

# S3-compatible storage: MinIO locally, Cloudflare R2 in the cloud
S3_ENDPOINT=http://localhost:9000
# Only when browsers reach storage at a different address than the server does (Docker on college servers)
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=vividh-media
S3_ACCESS_KEY=vividh
S3_SECRET_KEY=vividh-secret

# Google Drive service account (optional locally)
DRIVE_SA_EMAIL=
DRIVE_SA_KEY=
DRIVE_UPLOAD_FOLDER_ID=

# Shared secret for the retry cron (GitHub Actions -> /api/jobs)
CRON_SECRET=change-me

# Sign in without Google as any @ltsu.ac.in address. Development only; ignored in production.
DEV_LOGIN=1
